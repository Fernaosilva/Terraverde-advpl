/*/{Protheus.doc} etiqColl
Metodo responsavel pela impressão de Etiqueta Zebra -> Corpo ZPL de Collection
- Print Density: 12 dpmm (300 dpi)
- Label Size...: 5,5 x 2,5 cm
- Impressora Modelo ZD420, ZD230
@type function
@version 1.0
@author Patini
@since 10/2024
/*/
//-------------------------------------------------------------------------------------//
method etiqColl(nQtdd) class TvImpZebra
	Local cQuery   := ""
	Local cProd    := ""
	Local cGrupo   := ""
	Local nValor   := 0
	local lRet     := .T.
	local nQtd     := 0
	local cPorta   := "LPT1" //- \\localhost\ZD420-203dpi
	local cString  := ""
	local a1Area   := GetArea()
	local nTReg1   := 0
	Local nVlrPrv1 := SuperGetMv("MV_XPRV1",.F., 1.12)
	Local lQrcode  := .f.
	Local lCodBar  := .f.
//	Local nVlrPrv1 := GetDToVal(cVlrPrv1)  //converte o conteudo do parametro em numerico
	default nQtdd  := 1

	if ::cQrCodBar == "1"
		lQrCode := .t.
	else
		lCodBar := .t.
	endif
	cQuery := " SELECT DISTINCT B1_COD,B1_DESC, B1_GRUPO,B1_PRV1" +CRLF
	cQuery += " FROM "+RetSqlName('SB1')+ " SB1 (NOLOCK) " +CRLF
	cQuery += " WHERE D_E_L_E_T_= ' ' " +CRLF
	cQuery += " AND B1_FILIAL  =  '"+FwxFilial('SB1')+"'" + CRLF
	cQuery += " AND B1_COD BETWEEN '"+ALLTRIM(::cProdde)+"' AND '"+ALLTRIM(::cProdate)+"'"	+CRLF
	cQuery += " AND B1_GRUPO BETWEEN '"+ALLTRIM(::cGrupode)+"'AND '"+ALLTRIM(::cGrupoate)+"'"+CRLF
	cQuery += " ORDER BY 1"
	::cAlias1P := GetNextAlias()
	if !Empty(::cAlias1P) .And. Select(::cAlias1P) > 0
		(::cAlias1P)->(dbCloseArea())
	endif
	TcQuery cQuery New Alias (::cAlias1P)

	COUNT to nTReg1
	(::cAlias1P)->(dbGoTop())

	if nTReg1 == 0
		self:cError := "Nenhum registro encontrado para os filtros informados!"
	endif

	(::cAlias1P)->(dbGoTop())
	Do while (::cAlias1P)->(!eof())
		cProd := (::cAlias1P)->B1_COD
		cGrupo:= (::cAlias1p)->B1_GRUPO
		cDescr:= (::cAlias1P)->B1_DESC
		nValor:= (::cAlias1P)->B1_PRV1 * nVlrPrv1

		If lCodBar //codigo de barras
			cString += Chr(13)+Chr(10)+"^XA"
			cString += Chr(13)+Chr(10)+"^FX Etiqueta Collection - 5,5 x 2,5 cm."
			cString += Chr(13)+Chr(10)+"^MD30"
			cString += Chr(13)+Chr(10)+"^MMT"
			cString += Chr(13)+Chr(10)+"^PW777"
			cString += Chr(13)+Chr(10)+"^LL406"
			cString += Chr(13)+Chr(10)+"^LS0"
			cString += Chr(13)+Chr(10)+"^BY1,3,60^FT161,081^BCN,,N,N"
			cString += Chr(13)+Chr(10)+"^FH\^FD>:"+Alltrim(cProd)+">70000^FS" //codigo de barras
			//cString += Chr(13)+Chr(10)+"^FT0,061^A0N,33,34^FB0855,1,14,C^FH\^CI28^FDTERRAVERDE^FS^CI27" //titulo da etiqueta ou imagem
			cString += Chr(13)+Chr(10)+"^FO350,25^GFA,1250,1250,27,,:OFB,7NF3,3NF603JF8gP07C,3MFE607JF8gP07C,1MFEC07JF8gP07C,1MFC807JF8gP07C,I07FI018I0FCgR07C,I03FI03J07CgR07C,07F3F8003J07CgR07C,03F1F8006J07CgR07C,03F9FC006J07C007F00F9C78E0FF81F03E07F8079E07E7C03FC,01F8FC00CJ07C01FFC0FBC79E1FFE1F03C1FFC07BE1IFC0FFE,01FC7E008J07C03FFE0FFC7BE3FFE0F03C1FFE07BE1IFC1IF,,I07E33L07C0F8I0F807C07C0F03DF078I07807807C7C,I07F32L07C0F8I0F807C0780F01FE078I07807807C3C,I03F06L07C0F8I0F807C0F80F01FE07CI07807C07C3C,I03F84L07C07C040F807C0F81F01FE07C0607807C07C3E03,I01F8CL07C07C1F0F807C0F83F01FC03E0F07803E0FC1F078J0FD8L07C03IF0F807C0JF00FC03IF07803IFC1IF8J0FFM07C03FFE0F807C07IF00FC01FFE07801IFC0IF,J07FM07C00FF80F807C03FCF00FC00FFC07800FF3C07FE,J07EQ03CN01FN03EL018I01F,J03E,J03C,J018,K08,hK01C1E3E1F,hK01C3733198hK01C2331318hK0342031318hK03620I318hK026273E318hK0262736318hK07E2J318hK0632I3118hK0633F311F,hK041093184,^FS^FS^CI27"
			cString += Chr(13)+Chr(10)+"^FT0,131^A0N,33,34^FB1000,1,14,C^FH\^CI28^FD Valor: " +alltrim(transform(nValor,"@E 999,999,999.99"))+"^FS^CI27"//linha valor
			cString += Chr(13)+Chr(10)+"^FT0,131^A0N,33,34^FB450,1,14,C^FH\^CI28^FD"+Alltrim(cProd)+"^FS^CI27"         //linha produto
			cString += Chr(13)+Chr(10)+"^FPH,2^FT0,181^A0N,17,23^FB800,1,4,C^FH\^CI28^FD"+Alltrim(cDescr)+"^FS^CI27"   //linha descricao
			cString += Chr(13)+Chr(10)+"^PQ1,0,1,Y"
			cString += Chr(13)+Chr(10)+"^XZ"
			cString += Chr(13)+Chr(10)

		else//qrcode
			cString += Chr(13)+Chr(10)+"^XA"
			cString += Chr(13)+Chr(10)+"CI0^XZ"
			cString += Chr(13)+Chr(10)+"^XA"
			cString += Chr(13)+Chr(10)+"^MMT"
			cString += Chr(13)+Chr(10)+"^PW777"
			cString += Chr(13)+Chr(10)+"^LL0406"
			cString += Chr(13)+Chr(10)+"^LS0"
			cString += Chr(13)+Chr(10)+"^FT 165,110^BQN,2,4"
			cString += Chr(13)+Chr(10)+"^FDLA,"+Alltrim(cProd)+"^FS"
			cString += Chr(13)+Chr(10)+"^FO350,25^GFA,1250,1250,27,,:OFB,7NF3,3NF603JF8gP07C,3MFE607JF8gP07C,1MFEC07JF8gP07C,1MFC807JF8gP07C,I07FI018I0FCgR07C,I03FI03J07CgR07C,07F3F8003J07CgR07C,03F1F8006J07CgR07C,03F9FC006J07C007F00F9C78E0FF81F03E07F8079E07E7C03FC,01F8FC00CJ07C01FFC0FBC79E1FFE1F03C1FFC07BE1IFC0FFE,01FC7E008J07C03FFE0FFC7BE3FFE0F03C1FFE07BE1IFC1IF,,I07E33L07C0F8I0F807C07C0F03DF078I07807807C7C,I07F32L07C0F8I0F807C0780F01FE078I07807807C3C,I03F06L07C0F8I0F807C0F80F01FE07CI07807C07C3C,I03F84L07C07C040F807C0F81F01FE07C0607807C07C3E03,I01F8CL07C07C1F0F807C0F83F01FC03E0F07803E0FC1F078J0FD8L07C03IF0F807C0JF00FC03IF07803IFC1IF8J0FFM07C03FFE0F807C07IF00FC01FFE07801IFC0IF,J07FM07C00FF80F807C03FCF00FC00FFC07800FF3C07FE,J07EQ03CN01FN03EL018I01F,J03E,J03C,J018,K08,hK01C1E3E1F,hK01C3733198hK01C2331318hK0342031318hK03620I318hK026273E318hK0262736318hK07E2J318hK0632I3118hK0633F311F,hK041093184,^FS^FS^CI27"
			cString += Chr(13)+Chr(10)+"^FT0,131^A0N,33,34^FB930,1,14,C^FH\^CI28^FD Valor: " +alltrim(transform(nValor,"@E 999,999,999.99"))+"^FS^CI27"
			cString += Chr(13)+Chr(10)+"^FT0,131^A0N,33,34^FB550,1,14,C^FH\^CI28^FD"+Alltrim(cProd)+"^FS^CI27"
			cString += Chr(13)+Chr(10)+"^FPH,2^FT0,181^A0N,17,23^FB730,1,4,C^FH\^CI28^FD"+SubStr(Alltrim(cDescr),1,30)+"^FS^CI27"
