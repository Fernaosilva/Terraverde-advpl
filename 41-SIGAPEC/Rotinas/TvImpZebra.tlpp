//--------------------------------------------------------------------------------//
/*/{Protheus.doc} TvImpZebra
Rotina para impressao de Etiqueta Zebra com Cod.Barras
@type function
@version 1.0
@author Ademar Fernandes Jr
@Readaptado por : Patini ||Data: 10/2024
@since 26/10/2023
@link https://gkcmp.com.br (Geeker Company)
@return variant, Nil
/*/
//--------------------------------------------------------------------------------//
User Function TvImpZebra(aParam)
	local cRetorno := ""
	local cProcEmp := ""
	local cProcFil := ""

	private lIsInJob := (type("oMainWnd")<>"O")
	private cRotina  := "[ TvImpZebra ] "
	private cVerRot  := "V231025" //--Versao da rotina
	private aLjArea  := {}

	private oImpZebra := TvImpZebra():new()

	default aParam := {"01","01"}

	IF lIsInJob
		cProcEmp := aParam[1]
		cProcFil := aParam[2]

		rpcClearEnv()
		RpcSetType(3)
		RpcSetEnv(cProcEmp, cProcFil)
	EndIf

	ConOut( cRotina+ cVerRot+' - INICIO ----------------------------------> ' + TIME())

	if !lIsInJob
		//-Processa( bAcao, cTitulo, cMsg, lAborta )
		Processa({|| oImpZebra:execImpZebra()}, "Faz a impressao de etiqueta em impressora Zebra.", "Processando...")
	else
		oImpZebra:execImpZebra()
	endif

	ConOut( cRotina+ cVerRot+' - FINAL -----------------------------------> ' + TIME())

	cRetorno := oImpZebra:cError
	FreeObj(oImpZebra)
return cRetorno

/*/{Protheus.doc} TvImpZebra
Classe para impressao de Etiqueta Zebra com Cod.Barras
@type class
@version 1.0
@author Ademar Fernandes Jr.
@since 26/10/2023
/*/
	Class TvImpZebra

		public data cError	  as character
		private data cAlias1Q as character
		private data cAlias1P as character
		private data cTpEtiq  as character
		private data cProduto as character
		private data cProdde  as character
		private data cProdate as character
		private data cLocalde as character
		private data cLocalAte as character
		private data cGrupode as character
		private data cGrupoate as character
		private data cQrCodBar as character
		private data nQtdImp  as numeric
		private data cSerie   as character
		private data cNFiscal as character
		private data cFornec  as character
		private data cLojaFor as character
		private data cLocaliz as character

		public method new() constructor
		public method execImpZebra()	&& metodo que chama dos métodos de execução de Envio

		private method tela1Param()
		private method tela2Param()
		private method tela3Param()
		private method tela4Param()
		private method etiqProd(nQtdd)
		private method etiqColl(nQtdd)
		private method getLocaliz()
		private method etiqLocaliz(nQtdd)

	endClass

/*/{Protheus.doc} TvImpZebra::new
Metodo construtor da classe
@type method
@version 1.0
@author Ademar Fernandes Jr.
@since 26/10/2023
@return variant, return_description
/*/
method new() class TvImpZebra

	::cError   := ""
	::cAlias1Q := ""
	::cAlias1P := ""

	::cTpEtiq  := ""
	::cProduto := ""
	::cProdde  := ""
	::cProdate := ""
	::cLocalde := ""
	::cLocalAte := ""
	::cGrupode := ""
	::cGrupoate := ""
	::cQrCodBar := ""
	::cSerie   := ""
	::cNFiscal := ""
	::cFornec  := ""
	::cLojaFor := ""
	::nQtdImp  := 1
	::cLocaliz := ""

Return self

/*/{Protheus.doc} TvImpZebra::execImpZebra
Metodo responsavel pela ordenaçao e execuçao dos demais metodos
@type method
@version 1.0
@author Ademar Fernandes Jr.
@since 27/10/2023
@return variant, Nil
/*/
method execImpZebra() class TvImpZebra
	local nTReg := 0

	if ::tela1Param()

		if ::cTpEtiq == "1"	//-Etiq Produto
			Do While .T.
				if !::tela2Param()
					Exit
				else
					if !Empty(::cNFiscal+::cSerie)
						dbSelectArea("SD1")
						dbSetOrder(1)   //-D1_FILIAL+D1_DOC+D1_SERIE+D1_FORNECE+D1_LOJA+D1_COD+D1_ITEM
						If !dbSeek(FWxFilial("SD1")+::cNFiscal+::cSerie+::cFornec+::cLojaFor,.F.)
							MsgAlert(OemToAnsi("NF de Saída não encontrada."),OemToAnsi("[TerraVerde] Atenção!"))
							Return .F.
						else
							While !Eof() .And.;
									SD1->(D1_FILIAL+D1_DOC+D1_SERIE+D1_FORNECE+D1_LOJA) == FWxFilial("SD1")+::cNFiscal+::cSerie+::cFornec+::cLojaFor

								::cProduto := D1_COD
								::etiqProd()

								dbSelectArea("SD1")
								dbSkip()
							Enddo
						Endif

					elseif !Empty(::cProduto)
						::etiqProd(::nQtdImp)
					endIf
				endIf
			Enddo

		elseif ::cTpEtiq == "2"	//-Etiq Localização
			Do While .T.
				if !::tela3Param()
					Exit
				else
					if !Empty(::cLocalde) .or. !Empty(::cLocalAte)
						::etiqLocaliz()
					else
						//- Em 2023.11.22 o Lucas pediu para comentar essa funcionalidade!!!
						// nTReg := ::getLocaliz()
						nTReg := 0
						if nTReg > 0
							if !MsgYesNo(OemToAnsi("Confirma a impressão de "+Alltrim(Str(nTReg))+" etiquetas zebra ?"),OemToAnsi("[TerraVerde] Atenção!"))
								self:cError := "Cancelado pelo usuario!"
							else

								While !Eof()
									::cLocalde := BZ_LOCALI2
									::cLocalAte := BZ_LOCALI2
									::etiqLocaliz()

									dbSelectArea(::cAlias1Q)
									dbSkip()
								Enddo
							endif
						endif
					endif
				endif
			Enddo
		elseif ::cTpEtiq == "3" //-Etiq Collection
			Do While .T.
				if !::tela4Param()
					Exit
				else
					if !Empty(::cNFiscal+::cSerie)
						dbSelectArea("SD1")
						dbSetOrder(1)   //-D1_FILIAL+D1_DOC+D1_SERIE+D1_FORNECE+D1_LOJA+D1_COD+D1_ITEM
						If !dbSeek(FWxFilial("SD1")+::cNFiscal+::cSerie+::cFornec+::cLojaFor,.F.)
							MsgAlert(OemToAnsi("NF de Saída não encontrada."),OemToAnsi("[TerraVerde] Atenção!"))
							Return .F.
						else
							While !Eof() .And.;
									SD1->(D1_FILIAL+D1_DOC+D1_SERIE+D1_FORNECE+D1_LOJA) == FWxFilial("SD1")+::cNFiscal+::cSerie+::cFornec+::cLojaFor

								::cProdde := D1_COD
								::cProdate:= D1_COD
								::etiqColl()

								dbSelectArea("SD1")
								dbSkip()
							Enddo
						Endif

					elseif !Empty(::cProdde) .or. !Empty(::cProdate)
						::etiqColl(::nQtdImp)
					endIf
				endIf
			Enddo
		endif
	endif
Return

/*/{Protheus.doc} TvImpZebra::tela1Param
Metodo responsavel por apresentar tela de escolha do tipo de etiqueta
@type method
@version 1.0
@author Ademar Fernandes Jr.
@since 30/10/2023
@return variant, True / False
/*/
method tela1Param() class TvImpZebra
	local lRet      := .T.
	local aParamBox := {}
	local cTitle	:= OemToAnsi("Impressão de Etiquetas Zebra -")
	local aRetBox   := {}
	local bOk       := {|| (.T.)}
	local aButtons  := {}
	local lCentered := .T.
	local nPosX     := 0
	local nPosY     := 0
	local cLoad     := "" //--ProcName(1)
	local lCanSave  := .F.
	local lUserSave := .F.

	local aTpEtiq	:= StrTokArr("1- Etiq Produto;2- Etiq Localização;3- Etiq Collection",";")

	// Parametros da função Parambox()
	// -------------------------------
	// 1 - < aParametros > - Vetor com as configurações
	// 2 - < cTitle >      - Título da janela
	// 3 - < aRet >        - Vetor passador por referencia que contém o retorno dos parâmetros
	// 4 - < bOk >         - Code block para validar o botão Ok
	// 5 - < aButtons >    - Vetor com mais botões além dos botões de Ok e Cancel
	// 6 - < lCentered >   - Centralizar a janela
	// 7 - < nPosX >       - Se não centralizar janela coordenada X para início
	// 8 - < nPosY >       - Se não centralizar janela coordenada Y para início
	// 9 - < oDlgWizard >  - Utiliza o objeto da janela ativa
	//10 - < cLoad >       - Nome do perfil se caso for carregar
	//11 - < lCanSave >    - Salvar os dados informados nos parâmetros por perfil
	//12 - < lUserSave >   - Configuração por usuário

	// Tipo 1 -> MsGet()
	//			[2]-Descricao
	//          [3]-String contendo o inicializador do campo
	//          [4]-String contendo a Picture do campo
	//          [5]-String contendo a validacao
	//          [6]-Consulta F3
	//          [7]-String contendo a validacao When
	//          [8]-Tamanho do MsGet
	//          [9]-Flag .T./.F. Parametro Obrigatorio ?
	// Tipo 2 -> Combo
	//           [2]-Descricao
	//           [3]-Numerico contendo a opcao inicial do combo
	//           [4]-Array contendo as opcoes do Combo
	//           [5]-Tamanho do Combo
	//           [6]-Validacao
	//           [7]-Flag .T./.F. Parametro Obrigatorio ?
	// Tipo 11 -> MultiGet (Memo):
	// 			[2] = Descrição
	// 			[3] = Inicializador padrão
	// 			[4] = Validação
	// 			[5] = When
	// 			[6] = Campo com preenchimento obrigatório .T.=Sim .F.=Não (incluir a validação na função ParamOk)

	aadd(aParamBox, {2 , "Tipo de Etiqueta ", 1, aTpEtiq, 100, "", .T.})

	//-ParamBox(aParametros,cTitle,aRet,bOk,aButtons,lCentered,nPosX,nPosY,oDlgWizard,cLoad,lCanSave,lUserSave)
	if !ParamBox(aParamBox,cTitle,aRetBox,bOk,aButtons,lCentered,nPosX,nPosY,,cLoad,lCanSave,lUserSave)
		lRet := .F.
	else
		::cTpEtiq := iif(valType(aRetBox[1])=="N",Alltrim(Str(aRetBox[1])),SubStr(aRetBox[1],1,1))

		MV_PAR01 := ""	//-Space(Len(MV_PAR01))
	endif
Return lRet

/*/{Protheus.doc} TvImpZebra::tela2Param
Metodo responsavel por apresentar tela para escolha do produto ou NF
@type method
@version 1.0
@author Ademar Fernandes Jr.
@since 30/10/2023
@return variant, True / False
/*/
method tela2Param() class TvImpZebra
	local lRet      := .T.
	local aParamBox := {}
	local cTitle	:= OemToAnsi("Impressão de Etiqueta de Produto -")
	local aRetBox   := {}
	local bOk       := {|| (.T.)}
	local aButtons  := {}
	local lCentered := .T.
	local nPosX     := 0
	local nPosY     := 0
	local cLoad     := "" //--ProcName(1)
	local lCanSave  := .F.
	local lUserSave := .F.

	// local aQtdImp	:= StrTokArr("1- Por Produto;2- Qtd do Item da NF",";")

	// Parametros da função Parambox()
	// -------------------------------
	// 1 - < aParametros > - Vetor com as configurações
	// 2 - < cTitle >      - Título da janela
	// 3 - < aRet >        - Vetor passador por referencia que contém o retorno dos parâmetros
	// 4 - < bOk >         - Code block para validar o botão Ok
	// 5 - < aButtons >    - Vetor com mais botões além dos botões de Ok e Cancel
	// 6 - < lCentered >   - Centralizar a janela
	// 7 - < nPosX >       - Se não centralizar janela coordenada X para início
	// 8 - < nPosY >       - Se não centralizar janela coordenada Y para início
	// 9 - < oDlgWizard >  - Utiliza o objeto da janela ativa
	//10 - < cLoad >       - Nome do perfil se caso for carregar
	//11 - < lCanSave >    - Salvar os dados informados nos parâmetros por perfil
	//12 - < lUserSave >   - Configuração por usuário

	aadd(aParamBox, {1 , "Cod. Produto "     , Space(TamSX3("D1_COD")[1])    , "@!" , "Vazio() .Or. ExistCpo('SB1')", "SB1", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Qtd pra impressao ", 1							 , "@99", "Positivo()"				    , ""   , ".T." , 60, .F.})
	aadd(aParamBox, {1 , ""					 , ""							 , ""   , ""						    , ""   , ".T." ,  0, .F.})

	aadd(aParamBox, {1 , "Numero da NF "     , Space(TamSX3("D1_DOC")[1])    , "@!" , "Vazio() .Or. ExistCpo('SF1')", "SF1", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Serie da NF "      , Space(TamSX3("D1_SERIE")[1])  , "@!" , ""                            , ""   , ".T." , 60, .F.})
	aadd(aParamBox, {1 , "Fornecedor da NF " , Space(TamSX3("D1_FORNECE")[1]), "@!" , "Vazio() .Or. ExistCpo('SA2')", "SA2", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Loja da NF "       , Space(TamSX3("D1_LOJA")[1])   , "@!" , ""                            , ""   , ".T." , 60, .F.})
	aAdd(aParamBox, {2 , "Tipo de Impressão:", ::cQrCodBar, {"1=QrCode", "2=Codigo de Barras"}, 090, ".T.", .T.})

	//-ParamBox(aParametros,cTitle,aRet,bOk,aButtons,lCentered,nPosX,nPosY,oDlgWizard,cLoad,lCanSave,lUserSave)
	if !ParamBox(aParamBox,cTitle,aRetBox,bOk,aButtons,lCentered,nPosX,nPosY,,cLoad,lCanSave,lUserSave)
		lRet := .F.
	else
		::cProduto := aRetBox[1]
		::nQtdImp  := aRetBox[2]
		::cNFiscal := aRetBox[4]
		::cSerie   := aRetBox[5]
		::cFornec  := aRetBox[6]
		::cLojaFor := aRetBox[7]
		::cQrCodBar:= aRetBox[8]
	endif
Return lRet

/*/{Protheus.doc} TvImpZebra::tela3Param
