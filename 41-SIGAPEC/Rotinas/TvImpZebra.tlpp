	// 8 - < nPosY >       - Se não centralizar janela coordenada Y para início
	// 9 - < oDlgWizard >  - Utiliza o objeto da janela ativa
	//10 - < cLoad >       - Nome do perfil se caso for carregar
	//11 - < lCanSave >    - Salvar os dados informados nos parâmetros por perfil
	//12 - < lUserSave >   - Configuração por usuário

	aadd(aParamBox, {1 , "Localização de :"      , Space(TamSX3("BZ_LOCALI2")[1]), "@!", ""								, "SBZ"	, ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Localização ate: "      , Space(TamSX3("BZ_LOCALI2")[1]), "@!", ""								, "SBZ"	, ".T." , 80, .F.})
	aAdd(aParamBox, {2 , "Tipo de Impressão:", ::cQrCodBar, {"1=QrCode", "2=Codigo de Barras"}, 090, ".T.", .T.})
	// aadd(aParamBox, {1 , "Numero da NF "     , Space(TamSX3("D1_DOC")[1])    , "@!", "Vazio() .Or. ExistCpo('SF1')" , "SF1" , ".T." , 80, .F.})

	//-ParamBox(aParametros,cTitle,aRet,bOk,aButtons,lCentered,nPosX,nPosY,oDlgWizard,cLoad,lCanSave,lUserSave)
	if !ParamBox(aParamBox,cTitle,aRetBox,bOk,aButtons,lCentered,nPosX,nPosY,,cLoad,lCanSave,lUserSave)
		lRet := .F.
	else
		::cLocalde := aRetBox[1]
		::cLocalAte:= aRetBox[2]
		::cQrCodBar:= aRetBox[3]
	endif
Return lRet

/*/{Protheus.doc} TvImpZebra::tela4Param
Metodo responsavel por apresentar tela para escolha da Collection
@type method
@version 1.0
@author Patini
@since 10/2024
@return variant, True / False
/*/
method tela4Param() class TvImpZebra
	local lRet      := .T.
	local aParamBox := {}
	local cTitle	:= OemToAnsi("Impressão de Etiqueta de Collection -")
	local aRetBox   := {}
	local bOk       := {|| (.T.)}
	local aButtons  := {}
	local lCentered := .T.
	local nPosX     := 0
	local nPosY     := 0
	local cLoad     := "" //--ProcName(1)
	local lCanSave  := .F.
	local lUserSave := .F.


	// local aQtdImp	:= StrTokArr("1- Por Produto;2- Qtd do Item da NF",";")

	// Parametros da função Parambox()
	// -------------------------------
	// 1 - < aParametros > - Vetor com as configurações
	// 2 - < cTitle >      - Título da janela
	// 3 - < aRet >        - Vetor passador por referencia que contém o retorno dos parâmetros
	// 4 - < bOk >         - Code block para validar o botão Ok
	// 5 - < aButtons >    - Vetor com mais botões além dos botões de Ok e Cancel
	// 6 - < lCentered >   - Centralizar a janela
	// 7 - < nPosX >       - Se não centralizar janela coordenada X para início
	// 8 - < nPosY >       - Se não centralizar janela coordenada Y para início
	// 9 - < oDlgWizard >  - Utiliza o objeto da janela ativa
	//10 - < cLoad >       - Nome do perfil se caso for carregar
	//11 - < lCanSave >    - Salvar os dados informados nos parâmetros por perfil
	//12 - < lUserSave >   - Configuração por usuário

	aadd(aParamBox, {1 , "Numero da NF "     , Space(TamSX3("D1_DOC")[1])    , "@!" , "", "SF1", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Serie da NF "      , Space(TamSX3("D1_SERIE")[1])  , "@!" , ""                            , ""   , ".T." , 60, .F.})
	aadd(aParamBox, {1 , "Fornecedor da NF " , Space(TamSX3("D1_FORNECE")[1]), "@!" , "", "SA2", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Loja da NF "       , Space(TamSX3("D1_LOJA")[1])   , "@!" , ""                            , ""   , ".T." , 60, .F.})
	aadd(aParamBox, {1 , "Cod. Produto de : "     , Space(TamSX3("D1_COD")[1])    , "@!" , "", "SB1", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Cod. Produto ate: "     , Space(TamSX3("D1_COD")[1])    , "@!" , "", "SB1", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Grupo. Produto de: "     , Space(TamSX3("B1_GRUPO")[1])    , "@!" , "", "SBM", ".T." , 80, .F.})
	aadd(aParamBox, {1 , "Grupo. Produto ate: "     , Space(TamSX3("B1_GRUPO")[1])    , "@!" , "", "SBM", ".T." , 80, .F.})
	aAdd(aParamBox, {2 , "Tipo de Impressão:", ::cQrCodBar, {"1=QrCode", "2=Codigo de Barras"}, 090, ".T.", .T.})

	aadd(aParamBox, {1 , "Qtd pra impressao ", 1							 , "@99", "Positivo()"				    , ""   , ".T." , 60, .F.})
	aadd(aParamBox, {1 , ""					 , ""							 , ""   , ""						    , ""   , ".T." ,  0, .F.})


	//-ParamBox(aParametros,cTitle,aRet,bOk,aButtons,lCentered,nPosX,nPosY,oDlgWizard,cLoad,lCanSave,lUserSave)
	if !ParamBox(aParamBox,cTitle,aRetBox,bOk,aButtons,lCentered,nPosX,nPosY,,cLoad,lCanSave,lUserSave)
		lRet := .F.
	else
		::cNFiscal  := aRetBox[1]
		::cSerie    := aRetBox[2]
		::cFornec   := aRetBox[3]
		::cLojaFor  := aRetBox[4]
		::cProdde   := aRetBox[5]
		::cProdate  := aRetBox[6]
		::cGrupode  := aRetBox[7]
		::cGrupoate := aRetBox[8]
		::cQrCodBar := aRetBox[9]
		::nQtdImp   := aRetBox[10]

	endif
Return lRet


/*/{Protheus.doc} etiqProd
Metodo responsavel pela impressão de Etiqueta Zebra -> Corpo ZPL de Produtos
- Print Density: 12 dpmm (300 dpi)
- Label Size...: 5,5 x 2,5 cm
- Impressora Modelo ZD420, ZD230
@type function
@version 1.0
@author Ademar Fernandes Jr.
@since 27/10/2023
/*/
method etiqProd(nQtdd) class TvImpZebra
	local lRet     := .T.
	local nQtd     := 0
	local cPorta   := "LPT1" //- \\localhost\ZD420-203dpi
	local cString  := ""
	local a1Area   := GetArea()
	Local cCBA     := 'CBA'  //casa branca
	Local cJAU     := 'JAU'  //jau
	Local cMGM     := 'MGM'  //mogi mirim
	//Local cBAU     := 'BAU'  //bauru
	Local cLPA     := 'LPA'  //lencois paulista
	Local cARA     := 'ARA'  //araras
	Local cFER     := 'FER'  //pindamonhangaba
	Local cPIR     := 'PIR'  //piracicaba
	Local cBRA     := 'BRA'  //bragança paulista
	//Local cPFE     := 'PFE'  //porto ferreira
	Local cTBT     := 'TBT'  //taubate
	Local lQrcode  := .f.
	Local lCodBar  := .f.
	default nQtdd  := 1


	if ::cQrCodBar == "1"
		lQrCode := .t.
	else
		lCodBar := .t.
	endif

	dbSelectArea("SB1") //-Cadastro de Produtos
	dbSetOrder(1)       //-B1_FILIAL+B_COD
	If !dbSeek(FWxFilial("SB1")+::cProduto,.F.)
		self:cError := OemToAnsi("Produto não encontrado: "+Alltrim(::cProduto))
		MsgAlert(self:cError,OemToAnsi("[TerraVerde] Atenção!"))
		Return .F.
	Endif

	dbSelectArea("SBZ") //-Indicadores de Produtos
	dbSetOrder(1)       //-BZ_FILIAL+BZ_COD
	::cLocaliz := ""
	If dbSeek(FWxFilial("SBZ")+::cProduto,.F.)
		::cLocaliz := SBZ->BZ_LOCALI2
	Endif
	if lCodBar
		cString += Chr(13)+Chr(10)+"^XA"

		cString += Chr(13)+Chr(10)+"^FX Etiqueta de produtos - 5,5 x 2,5 cm."
		cString += Chr(13)+Chr(10)+"^MD30"
		cString += Chr(13)+Chr(10)+"^MMT"
		cString += Chr(13)+Chr(10)+"^PW777"	//-"^PW831"
		cString += Chr(13)+Chr(10)+"^LL406"
		cString += Chr(13)+Chr(10)+"^LS0"

		cString += Chr(13)+Chr(10)+"^BY1,3,60^FT161,081^BCN,,N,N"   //-BY2=Cod.Barras.Grande; BY1=Cod.Barras.Pequeno
		cString += Chr(13)+Chr(10)+"^FH\^FD>:"+Alltrim(::cProduto)+">70000^FS"
		if !Empty(::cLocaliz)
			cString += Chr(13)+Chr(10)+"^FT0,071^A0N,33,34^FB1111,1,14,C^FH\^CI28^FD"+Alltrim(::cLocaliz)+"^FS^CI27"
		endif
		cString += Chr(13)+Chr(10)+"^FT0,141^A0N,55,56^FB809,1,14,C^FH\^CI28^FD"+Alltrim(::cProduto)+"^FS^CI27"
		cString += Chr(13)+Chr(10)+"^FPH,2^FT0,181^A0N,17,23^FB800,1,4,C^FH\^CI28^FD"+Alltrim(SB1->B1_DESC)+"^FS^CI27"

		//Patini: Tratamento para carregar a sigla da filial
		if cFilAnt == '0101'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cCBA+"^FS^CI27"
		elseif cFilAnt == '0102'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cJAU+"^FS^CI27"
		elseif cFilAnt == '0103'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cMGM+"^FS^CI27"
		elseif cFilAnt == '0105'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cLPA+"^FS^CI27"
		elseif cFilAnt == '0106'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cARA+"^FS^CI27"
		elseif cFilAnt == '0109'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cFER+"^FS^CI27"
		elseif cFilAnt == '0110'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cTBT+"^FS^CI27"
		elseif cFilAnt == '0111'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cPIR+"^FS^CI27"
		elseif cFilAnt == '0112'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cBRA+"^FS^CI27"
		endif

		cString += Chr(13)+Chr(10)+"^PQ1,0,1,Y"
		cString += Chr(13)+Chr(10)+"^XZ"
		cString += Chr(13)+Chr(10)

	else //qrcode

		cString += Chr(13)+Chr(10)+"^XA"

		cString += Chr(13)+Chr(10)+"CI0^XZ"
		cString += Chr(13)+Chr(10)+"^XA"
		cString += Chr(13)+Chr(10)+"^MMT"
		cString += Chr(13)+Chr(10)+"^PW777"	//-"^PW831"
		cString += Chr(13)+Chr(10)+"^LL406"
		cString += Chr(13)+Chr(10)+"^LS0"

		cString += Chr(13)+Chr(10)+"^FT 145,120^BQN,2,3"   //-BY2=Cod.Barras.Grande; BY1=Cod.Barras.Pequeno
		cString += Chr(13)+Chr(10)+"^FDLA,"+Alltrim(::cProduto)+"^FS"
		if !Empty(::cLocaliz)
			cString += Chr(13)+Chr(10)+"^FT0,071^A0N,33,34^FB1111,1,14,C^FH\^CI28^FD"+Alltrim(::cLocaliz)+"^FS^CI27"
		endif
		cString += Chr(13)+Chr(10)+"^FT0,141^A0N,55,56^FB809,1,14,C^FH\^CI28^FD"+Alltrim(::cProduto)+"^FS^CI27"
		cString += Chr(13)+Chr(10)+"^FPH,2^FT0,181^A0N,17,23^FB800,1,4,C^FH\^CI28^FD"+Alltrim(SB1->B1_DESC)+"^FS^CI27"

		//Patini: Tratamento para carregar a sigla da filial
		if cFilAnt == '0101'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cCBA+"^FS^CI27"
		elseif cFilAnt == '0102'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cJAU+"^FS^CI27"
		elseif cFilAnt == '0103'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cMGM+"^FS^CI27"
		elseif cFilAnt == '0105'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cLPA+"^FS^CI27"
		elseif cFilAnt == '0106'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cARA+"^FS^CI27"
		elseif cFilAnt == '0109'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cFER+"^FS^CI27"
		elseif cFilAnt == '0110'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cTBT+"^FS^CI27"
		elseif cFilAnt == '0111'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cPIR+"^FS^CI27"
		elseif cFilAnt == '0112'
			cString += Chr(13)+Chr(10)+"^FT0,181^A0N,17,23^FB350,1,4,C^FH\^CI28^FD"+cBRA+"^FS^CI27"
		endif

		cString += Chr(13)+Chr(10)+"^PQ1,0,1,Y"
		cString += Chr(13)+Chr(10)+"^XZ"
		cString += Chr(13)+Chr(10)
	endif

	MemoWrite("IMPZEBRA.TXT",cString)
	CpyS2T( "IMPZEBRA.TXT", "C:\TEMP", .F. )

	cString	:= "copy impzebra.txt "+cPorta +chr(13)+chr(10)

	MemoWrite("IMPZEBRA.BAT",cString)
	CpyS2T( "IMPZEBRA.BAT", "C:\TEMP", .F. )

	For nQtd := 1 To nQtdd
		////nRet := WinExec("C:\TEMP\IMPZEBRA.BAT")
		ShellExecute("OPEN", "Impzebra.bat", "", "c:\temp\", 1)
		Inkey(1)
	Next nQtd

	RestArea(a1Area)
Return lRet

/*/{Protheus.doc} etiqLocaliz
Metodo responsavel pela impressão de Etiqueta Zebra -> Corpo ZPL da Localizaçao
- Print Density: 12 dpmm (300 dpi)
- Label Size...: 5,5 x 2,5 cm
@type function
@version 1.0
@author Ademar Fernandes Jr.
@since 31/10/2023
/*/
method etiqLocaliz(nQtdd) class TvImpZebra
	local lRet     := .T.
	local cPorta   := "LPT1" //- \\localhost\ZD420-203dpi
	local cString  := ""
	local a1Area   := GetArea()
	Local lQrcode  := .f.
	Local lCodBar  := .f.
	Local cQuery1  := ""
	Local nQtd     := 0
	local nTReg1  := 0
	Local cLocaliz := ""
	default nQtdd  := 1

	cQuery1 := " SELECT DISTINCT BZ_FILIAL,BZ_LOCALI2 "+CRLF
	cQuery1 += " FROM "+RetSqlName("SBZ")+ " SBZ (nolock)"+CRLF
	cQuery1 += " WHERE SBZ.D_E_L_E_T_ = ' ' "+CRLF
	cQuery1 += "	AND BZ_FILIAL   = '"+FwxFilial("SBZ")+"' "+CRLF
	cQuery1 += "    AND BZ_LOCALI2 BETWEEN '"+ALLTRIM(::cLocalde)+"' AND '"+ALLTRIM(::cLocalAte)+"'"+CRLF
	cQuery1 += " ORDER BY BZ_FILIAL,BZ_LOCALI2 "+ CRLF

	cQuery1 := ChangeQuery(cQuery1)

	::cAlias1Q := GetNextAlias()
	if !Empty(::cAlias1Q) .And. Select(::cAlias1Q) > 0
		(::cAlias1Q)->(dbCloseArea())
	endif
	TcQuery cQuery1 New Alias (::cAlias1Q)

	COUNT to nTReg1
	(::cAlias1Q)->(dbGoTop())

	if nTReg1 == 0
		self:cError := "Nenhum registro encontrado para os filtros informados!"
	endif

	if ::cQrCodBar == "1"
		lQrCode := .t.
	else
		lCodBar := .t.
	endif

	(::cAlias1Q)->(dbGoTop())
	Do while (::cAlias1Q)->(!eof())
		cLocaliz := (::cAlias1Q)->BZ_LOCALI2

		if lCodBar //CODIGO DE BARRAS

			cString += Chr(13)+Chr(10)+"^XA"

			cString += Chr(13)+Chr(10)+"^FX Etiqueta de localizaçao (SBZ) - 5,5 x 2,5 cm."
			cString += Chr(13)+Chr(10)+"^MMT"
			cString += Chr(13)+Chr(10)+"^PW777"	//-"^PW831"
			cString += Chr(13)+Chr(10)+"^LL406"
			cString += Chr(13)+Chr(10)+"^LS0"

			cString += Chr(13)+Chr(10)+"^BY1,3,60^FT161,081^BCN,,N,N"   //-BY2=Cod.Barras.Grande; BY1=Cod.Barras.Pequeno
			cString += Chr(13)+Chr(10)+"^FH\^FD>:"+Alltrim(cLocaliz)+">70000^FS"
			cString += Chr(13)+Chr(10)+"^FT0,141^A0N,55,56^FB809,1,14,C^FH\^CI28^FD"+Alltrim(cLocaliz)+"^FS^CI27"

			cString += Chr(13)+Chr(10)+"^PQ1,0,1,Y"
			cString += Chr(13)+Chr(10)+"^XZ"
			cString += Chr(13)+Chr(10)

		else //QRCODE
			cString += Chr(13)+Chr(10)+"^XA"
			cString += Chr(13)+Chr(10)+"CI0^XZ"
			cString += Chr(13)+Chr(10)+"^XA"

			cString += Chr(13)+Chr(10)+"^FX Etiqueta de localizaçao (SBZ) - 5,5 x 2,5 cm."
			cString += Chr(13)+Chr(10)+"^MMT"
			cString += Chr(13)+Chr(10)+"^PW777"	//-"^PW831"
			cString += Chr(13)+Chr(10)+"^LL0406"
			cString += Chr(13)+Chr(10)+"^LS0"

			cString += Chr(13)+Chr(10)+"^FT 145,100^BQN,2,3"   //-BY2=Cod.Barras.Grande; BY1=Cod.Barras.Pequeno
			cString += Chr(13)+Chr(10)+"^FDLA, "+Alltrim(cLocaliz)+"^FS"
			cString += Chr(13)+Chr(10)+"^FT0,141^A0N,55,56^FB809,1,14,C^FH\^CI28^FD"+Alltrim(cLocaliz)+"^FS^CI27"

			cString += Chr(13)+Chr(10)+"^PQ1,0,1,Y"
			cString += Chr(13)+Chr(10)+"^XZ"
			cString += Chr(13)+Chr(10)
		endif
        MemoWrite("IMPZEBRA.TXT",cString)
		CpyS2T( "IMPZEBRA.TXT", "C:\TEMP", .F. )

		cString	:= "copy impzebra.txt "+cPorta +chr(13)+chr(10)

		MemoWrite("IMPZEBRA.BAT",cString)
		CpyS2T( "IMPZEBRA.BAT", "C:\TEMP", .F. )

		For nQtd := 1 To nQtdd
			////nRet := WinExec("C:\TEMP\IMPZEBRA.BAT")
			ShellExecute("OPEN", "Impzebra.bat", "", "c:\temp\", 1)
			Inkey(1)
		Next nQtd

		(::cAlias1Q)->(dbSkip())
	EndDo

	RestArea(a1Area)
	Inkey(1)
Return lRet

/*/{Protheus.doc} TvImpZebra::getLocaliz
Metodo responsavel por buscar as localizaçoes na SBZ
@type method
@version 1.0
@author Ademar Fernandes Jr.
@since 31/10/2023
@return variant, Qtd de registros
/*/
method getLocaliz() class TvImpZebra
	local nTReg1  := 0
	local cQuery1 := ""

	dbSelectArea("SBZ") //-Indicadores de Produtos
	dbSetOrder(1)       //-BZ_FILIAL+BZ_COD

	cQuery1 += " SELECT DISTINCT "
	cQuery1 += " BZ_FILIAL,BZ_LOCALI2 "
	cQuery1 += " FROM "+RetSqlName("SBZ")+" SBZ "
	cQuery1 += " WHERE SBZ.D_E_L_E_T_ = ' ' "
	cQuery1 += "	AND BZ_FILIAL   = '"+FwxFilial("SBZ")+"' "
	cQuery1 += "	AND BZ_LOCALI2 >= '0' "
	cQuery1 += "    AND BZ_LOCALI2 '"+ALLTRIM(::cLocalde)+"' AND '"+ALLTRIM(::cLocalAte)+"'"
	cQuery1 += " ORDER BY BZ_FILIAL,BZ_LOCALI2 "

	cQuery1 := ChangeQuery(cQuery1)

	::cAlias1Q := GetNextAlias()
	if !Empty(::cAlias1Q) .And. Select(::cAlias1Q) > 0
		(::cAlias1Q)->(dbCloseArea())
	endif
	TcQuery cQuery1 New Alias (::cAlias1Q)

	COUNT to nTReg1
	(::cAlias1Q)->(dbGoTop())

	if nTReg1 == 0
		self:cError := "Nenhum registro encontrado para os filtros informados!"
	endif
return nTReg1

